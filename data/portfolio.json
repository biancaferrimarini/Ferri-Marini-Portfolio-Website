          "collection": "9f43f5dd-b585-4fdb-8ca5-8606ca56c093",
          "status": "published",
          "order": 10,
          "year": "2026",
          "category": "Remake — Desigual “Animal Fur” Coat",
          "concept": "An expressive outerwear piece, digitally rebuilt through texture, surface, and silhouette.",
          "description": "This project is a digital remake of Desigual’s “Animal Fur” coat, recreated with a focus on surface realism and material interpretation. The animal-inspired fur pattern was rebuilt manually to closely match the original campaign imagery, while the fur texture, pile length, and overall finish were carefully adjusted to achieve a more faithful visual result. The front buttons were also remodelled separately in Blender to reflect the original design more accurately.",
          "software": [
            "CLO3D",
            "Blender"
          ],
          "techniques": [
            "Digital patternmaking",
            "Fabric simulation",
            "Garment reconstruction",
            "Fur material development",
            "Custom surface texturing",
            "Button modelling",
            "Rendering"
          ],
          "construction": [
            {
              "label": "Fit",
              "text": "Straight, longline fit with a clean vertical silhouette. The coat falls close to the body while maintaining a structured outerwear proportion."
            },
            {
              "label": "Collar / Neckline",
              "text": "Classic rounded collar with a simple, clean neckline. The collar structure reinforces the coat’s tailored appearance."
            },
            {
              "label": "Pockets",
              "text": "Visible pockets are featured on the rendered version. The design remains visually clean across the front."
            },
            {
              "label": "Seams & topstitching",
              "text": "Construction lines are kept minimal for a polished finish. Front closure, collar and structural seams remain discreet, with very subtle visible stitching."
            },
            {
              "label": "Fabric",
              "text": "The coat is interpreted through a faux-fur-inspired surface with a custom recreated animal pattern. The texture and fur quality were manually refined to better match the original visual reference."
            },
            {
              "label": "Volume",
              "text": "The overall volume is elongated and moderately structured. The surface softness of the fur contrasts with the coat’s clean and controlled shape."
            }
          ],
          "reference": {
