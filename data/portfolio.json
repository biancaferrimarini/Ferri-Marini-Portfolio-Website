        {
          "id": "e9f0a73c-4855-49da-b6cd-67ef7f075f31",
          "anchor": "study-02",
          "title": "Pleats in Motion",
          "collection": "9f43f5dd-b585-4fdb-8ca5-8606ca56c093",
          "status": "published",
          "order": 20,
          "year": "2026",
          "category": "Remake — Neiman Marcus Pleated Pants",
          "concept": "Where structured tailoring meets fluid movement.",
          "description": "A digital reconstruction of Neiman Marcus pleated trousers, exploring the interplay between tailored structure and soft draping. High-waisted proportions, sculptural front pleats, and a tapered silhouette are recreated in CLO 3D, with a pastel blue silk-like crepe material that emphasizes subtle texture, luminosity, and natural fabric movement.",
          "software": [
            "CLO3D"
          ],
          "techniques": [
            "Tailoring",
            "Texturing",
            "Rendering"
          ],
          "construction": [
            {
              "label": "Fit",
              "text": "High-waisted tailored fit with a defined waistband, generous volume through the hips, and a softly tapered leg. "
            },
            {
              "label": "Collar / Neckline",
              "text": "Not applicable — structured high-rise waistband."
            },
            {
              "label": "Pockets",
              "text": "Slanted side pockets integrated into the upper hip area, following the natural flow of the pleats."
            },
            {
              "label": "Seams & topstitching",
              "text": "Clean, discreet seam construction with minimal visible topstitching. Subtle seam definition preserves the smooth, refined appearance of the garment."
            },
            {
              "label": "Fabric",
              "text": "Pastel blue silk-like chambray crepe with a fine woven texture, soft luminosity, and fluid drape. The simulated fabric balances gentle structure at the waist with natural folds and movement along the legs."
            },
            {
              "label": "Volume",
              "text": "Deep front pleats create controlled volume through the upper leg, transitioning into an elongated, tapered silhouette. A clean waistband reinforces the tailored construction."
            }
          ],
          "reference": {
            "src": "assets/images/mwqbhtgg-q10itdah.jpg",
